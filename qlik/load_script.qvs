// ============================================================================
// Container Shipping KPIs – Qlik Sense load script
// Same star schema as the Power BI version, loaded from the CSV exports.
//
// Qlik Cloud: upload output/*.csv to the "DataFiles" space, then paste this
// into the Data load editor. (Qlik Sense Desktop/Enterprise: point the lib://
// connection at the local output/ folder instead.)
// ============================================================================

// CSVs use '.' as decimal separator — set explicitly so a German-locale
// app doesn't misread 6553833.61 as text or a different number.
SET DecimalSep='.';
SET ThousandSep=',';
SET DateFormat='YYYY-MM-DD';

LET vPath = 'lib://DataFiles/';

// ---------------------------------------------------------------------------
// Dimensions
// ---------------------------------------------------------------------------
dim_trade:
LOAD trade_id, trade_code, trade_name, region, head_office
FROM [$(vPath)dim_trade.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

dim_month:
LOAD
    month_id,
    Date(Date#(period_date, 'YYYY-MM-DD')) AS period_date,
    year,
    month,
    Dual(month_name, month)                AS month_name,   // sorts Jan..Dec
    quarter,
    month_seq
FROM [$(vPath)dim_month.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

dim_cost_category:
LOAD cost_category_id, cost_category, cost_group
FROM [$(vPath)dim_cost_category.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

// ---------------------------------------------------------------------------
// Fact: actual + budget joined into ONE table.
// Loading them as two tables would give Qlik two tables sharing trade_id,
// month_id and cost_category_id -> a synthetic key. Both facts have the same
// grain (trade x month x cost category), so a join is 1:1 and lossless.
// fact_id is dropped: it is a per-table surrogate and would mis-associate.
// ---------------------------------------------------------------------------
fact:
LOAD trade_id, month_id, cost_category_id, teu_volume, cost_actual_usd
FROM [$(vPath)fact_actual.csv] (txt, utf8, embedded labels, delimiter is ',', msq);

LEFT JOIN (fact)
LOAD trade_id, month_id, cost_category_id, teu_volume_budget, cost_budget_usd
FROM [$(vPath)fact_budget.csv] (txt, utf8, embedded labels, delimiter is ',', msq);
